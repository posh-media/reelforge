# Reelforge environment variables
# These values are not used in Phase 1; they will be wired into Firebase/API services in Phases 2-4.

# Firebase (web SDK config)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# API keys (stored via Cloud Function + Secret Manager in Phase 2)
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FALAI_API_KEY=
SYNC_LABS_API_KEY=

# Phase 2 seeding toggle — set to false before Phase 4 to disable mock-project seeding
REELFORGE_SEED_MOCK_PROJECTS=true

# YouTube OAuth / API (Phase 4)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
