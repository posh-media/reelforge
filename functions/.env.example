# Cloud Run stitch / upload service base URL (no trailing /stitch or /upload)
# The deploy-stitch-service workflow writes this automatically after deploying.
STITCH_SERVICE_URL=https://stitch-service-xxxxxxxxxx-uc.a.run.app/stitch

# YouTube OAuth app credentials (server-side only)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Optional: override the Anthropic model used for metadata generation
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
